#══════════════════════════════════════════════════════════════════════════════
#  LLM Selfbot, environment
#
#  Secrets and per-account credentials live here. Everything below can also be
#  edited inside the app: Settings → Environment, where each option shows the
#  description written above it in this file.
#
#  Values are read when an account starts, so restart the affected account
#  after changing one. Lines beginning with # are ignored.
#══════════════════════════════════════════════════════════════════════════════


# ── Discord ───────────────────────────────────────────────────────────────────
#
# Add as many tokens as you want, numbered from 1. Each token runs as a fully
# independent bot instance with its own memory, stats and IPC channel.
#
# Optionally pair a token with a proxy. If no proxy is set for a token, that
# account uses your local IP.
#
#   http://host:port                 socks5://host:port
#   http://user:pass@host:port       socks5://user:pass@host:port
#
# DISCORD_TOKEN_1=YOUR_FIRST_TOKEN_HERE
# DISCORD_PROXY_1=http://user:pass@proxy1.example.com:8080
#
# DISCORD_TOKEN_2=YOUR_SECOND_TOKEN_HERE
# DISCORD_PROXY_2=socks5://proxy2.example.com:1080
#
# DISCORD_TOKEN_3=YOUR_THIRD_TOKEN_HERE
# ...with no DISCORD_PROXY_3, so account 3 uses the local IP.

# Legacy single-token fallback, used only when DISCORD_TOKEN_1 is not set.
DISCORD_TOKEN=TOKEN_GOES_HERE
# DISCORD_PROXY=http://user:pass@proxy.example.com:8080


# ── Telegram control bot ──────────────────────────────────────────────────────
#
# Optional. Lets you drive the selfbot from Telegram; the web panel does the
# same job. Both must be set for it to start.
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id_here


# ── Groq API ──────────────────────────────────────────────────────────────────
#
# The AI brain. Add as many keys as you want, numbered from 1: when one hits
# its rate limit the bot falls back to the next, and once every key is
# exhausted it falls back to the next model listed in config.yaml.
#
# GROQ_API_KEY_1=YOUR_FIRST_GROQ_KEY_HERE
# GROQ_API_KEY_2=YOUR_SECOND_GROQ_KEY_HERE
# GROQ_API_KEY_3=YOUR_THIRD_GROQ_KEY_HERE

# Legacy single-key fallback, used only when GROQ_API_KEY_1 is not set.
GROQ_API_KEY=GROQ_API_KEY_GOES_HERE


# ── Snapchat account ──────────────────────────────────────────────────────────
#
# Required when snapchat.enabled is true in config.yaml. Snapchat has no API,
# so this drives a real Chrome window through Puppeteer.
SNAP_USERNAME=your_snapchat_username
SNAP_PASSWORD=your_snapchat_password

# More Snapchat accounts work like the Discord tokens: add _2, _3 and each gets
# its own browser, cookies and IPC channel. Account 1 is SNAP_USERNAME above
# (or SNAP_USERNAME_1). Target them from Telegram with /account snap, snap2, …
#
# SNAP_USERNAME_2=second_account_username
# SNAP_PASSWORD_2=second_account_password
#
# SNAP_USERNAME_3=third_account_username
# SNAP_PASSWORD_3=third_account_password


# ── Snapchat browser ──────────────────────────────────────────────────────────

# Run Puppeteer headless, with no visible browser window. The first login needs
# a visible window; cookies are saved afterwards, so later runs can be headless.
# SNAP_HEADLESS=false

# The Python bridge launches the Node browser runner in the same window.
# Set false to run the runner yourself in a second terminal.
# SNAP_SPAWN_NODE=true

# Print candidate elements when a snap cannot be opened. Useful for retuning
# the selectors after Snapchat changes its layout.
# SNAP_DEBUG=1


# ── Snapchat polling ──────────────────────────────────────────────────────────

# How often to check for new messages, and how long to wait on a reply.
# SNAP_POLL_INTERVAL_MS=8000
# SNAP_RESPONSE_POLL_MS=3000
# SNAP_RESPONSE_TIMEOUT_MS=60000

# Only open chats the list marks unread, instead of clicking into every visible
# chat each poll. Set false if unread detection misbehaves on your build and
# the bot stops replying.
# SNAP_ONLY_UNREAD=true

# Scroll the chat list to reach conversations below the fold. The list is
# virtualised, so off-screen chats are invisible otherwise. Set false to only
# ever consider the chats already visible at the top.
# SNAP_SCROLL_CHAT_LIST=true
# SNAP_MAX_SCROLL_STEPS=40


# ── Snapchat behaviour ────────────────────────────────────────────────────────

# Open and screenshot incoming Snaps so the AI can actually see them, the same
# way images work on Discord. Only fires when a chat has an unopened snap.
# SNAP_CAPTURE_SNAPS=true

# Transcribe incoming voice messages with Groq Whisper, so the AI replies to
# what was said rather than ignoring it.
# SNAP_CAPTURE_VOICE=true

# Decline incoming voice and video calls, then send a casual "can't talk rn".
# SNAP_DECLINE_CALLS=true

# Save every message in a chat (hover → "Save in Chat") so the conversation
# does not disappear.
# SNAP_SAVE_MESSAGES=true

# Show the live "typing…" indicator to the other person while the bot types.
# SNAP_SHOW_TYPING=true

# Floor for the typing delay in ms. Actual typing time scales with the length
# of the message.
# SNAP_TYPING_DELAY_MS=1200

# Accept pending friend requests automatically (the person+ badge). Accepts a
# small batch each interval, interleaved with chatting, so replies never stall.
# SNAP_AUTO_ADD_FRIENDS=true
# SNAP_FRIEND_ADD_INTERVAL_MS=20000
# SNAP_FRIEND_ADD_BATCH=5


# ── Snapchat anti-ban send governor ───────────────────────────────────────────
#
# Spaces outbound messages so the account does not look like a spam bot: a
# randomised gap between any two sends, a rolling hourly cap, and optional
# quiet hours. Lower the cap or raise the gaps for safety at the cost of speed.

# Minimum milliseconds between two sends.
# SNAP_MIN_SEND_GAP_MS=9000

# Maximum milliseconds between two sends; the real gap is randomised between
# the two.
# SNAP_MAX_SEND_GAP_MS=28000

# Rolling hourly cap. Once reached, the bot waits rather than sending.
# SNAP_MAX_SENDS_PER_HOUR=45

# Local 24-hour window to stay silent, as START-END. Leave empty to always run.
# SNAP_QUIET_HOURS=2-9
