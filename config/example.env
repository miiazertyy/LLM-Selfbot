# --- Discord Tokens & Proxies ---
# Add as many tokens as you want, numbered from 1.
# Each token runs as a fully independent bot instance.
# Optionally pair each token with a proxy — if no proxy is set, the local IP is used.
#
# Supported proxy formats:
#   http://host:port
#   http://user:pass@host:port
#   socks5://host:port
#   socks5://user:pass@host:port
#
# DISCORD_TOKEN_1=YOUR_FIRST_TOKEN_HERE
# DISCORD_PROXY_1=http://user:pass@proxy1.example.com:8080
#
# DISCORD_TOKEN_2=YOUR_SECOND_TOKEN_HERE
# DISCORD_PROXY_2=socks5://proxy2.example.com:1080
#
# DISCORD_TOKEN_3=YOUR_THIRD_TOKEN_HERE
# (no DISCORD_PROXY_3 = uses local IP)

# Legacy single-token fallback (used if no DISCORD_TOKEN_1 is set)
DISCORD_TOKEN=TOKEN_GOES_HERE
# DISCORD_PROXY=http://user:pass@proxy.example.com:8080

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id_here

# --- Groq API ---
# Add as many API keys as you want, numbered from 1.
# When a key hits its rate limit, the bot automatically falls back to the next one.
# Once all keys are exhausted, it falls back to the next model in your config.
# GROQ_API_KEY_1=YOUR_FIRST_GROQ_KEY_HERE
# GROQ_API_KEY_2=YOUR_SECOND_GROQ_KEY_HERE
# GROQ_API_KEY_3=YOUR_THIRD_GROQ_KEY_HERE

# Legacy single-key fallback (used if no GROQ_API_KEY_1 is set)
GROQ_API_KEY=GROQ_API_KEY_GOES_HERE

# --- Gemini API ---
GEMINI_API_KEY=your_key_here

# --- Snapchat Credentials ---
# Required if snapchat.enabled = true in config.yaml
SNAP_USERNAME=your_snapchat_username
SNAP_PASSWORD=your_snapchat_password

# Multiple Snapchat accounts (like DISCORD_TOKEN_1/_2). Add _2, _3, ... and each
# gets its own browser, cookies, and IPC channel. Account 1 = SNAP_USERNAME above
# (or SNAP_USERNAME_1). Target them from Telegram with /account snap, snap2, ...
# SNAP_USERNAME_2=second_account_username
# SNAP_PASSWORD_2=second_account_password
# SNAP_USERNAME_3=third_account_username
# SNAP_PASSWORD_3=third_account_password

# Optional: run Puppeteer headless (no visible browser window)
# SNAP_HEADLESS=false

# Optional: polling intervals (milliseconds)
# SNAP_POLL_INTERVAL_MS=8000
# SNAP_RESPONSE_POLL_MS=3000
# SNAP_RESPONSE_TIMEOUT_MS=60000

# Optional: only open chats the list shows as unread (default true). This stops
# the bot clicking into every visible chat each poll. Set false if unread
# detection misbehaves on your Snapchat build and the bot stops replying.
# SNAP_ONLY_UNREAD=true

# Optional: scroll the chat list to load older conversations below the fold (the
# list is virtualized, so off-screen chats aren't otherwise seen). Default true.
# Set false to only ever consider the chats already visible at the top.
# SNAP_SCROLL_CHAT_LIST=true
# SNAP_MAX_SCROLL_STEPS=40

# Optional: open + screenshot incoming Snaps so the AI can actually "see" them
# (like the Discord image flow). On by default; only fires when a chat has an
# unopened snap. Set false to disable.
# SNAP_CAPTURE_SNAPS=true

# Optional: set to 1 to print candidate elements when a snap can't be opened —
# helps tune the snap selectors if Snapchat changes its layout.
# SNAP_DEBUG=1

# Optional: transcribe incoming voice messages (Groq Whisper) so the AI replies
# to what was said. On by default. Set false to disable.
# SNAP_CAPTURE_VOICE=true

# ── Anti-ban send governor ───────────────────────────────────────────────────
# Spaces outbound messages out so the account doesn't look like a spam bot. A
# randomised gap between any two sends, a rolling hourly cap, and optional quiet
# "sleep" hours. Lower the cap / raise the gaps = safer but slower to reply.
# SNAP_MIN_SEND_GAP_MS=9000       # min ms between two sends (default 9s)
# SNAP_MAX_SEND_GAP_MS=28000      # max ms between two sends, randomised (default 28s)
# SNAP_MAX_SENDS_PER_HOUR=45      # rolling cap; over this it waits
# SNAP_QUIET_HOURS=2-9            # local 24h window to go silent (empty = always on)

# Optional: auto-decline incoming voice/video calls (click "Not Now") and send a
# casual "can't talk rn" chat instead. On by default. Set false to disable.
# SNAP_DECLINE_CALLS=true

# Optional: automatically accept pending friend requests (the person+ badge).
# On by default. Accepts a small BATCH each INTERVAL (interleaved with chatting)
# so it never freezes replies. Set SNAP_AUTO_ADD_FRIENDS=false to disable.
# SNAP_AUTO_ADD_FRIENDS=true
# SNAP_FRIEND_ADD_INTERVAL_MS=20000
# SNAP_FRIEND_ADD_BATCH=5

# Optional: save every message in a chat (hover -> "Save in Chat") so the
# conversation doesn't disappear. On by default; set false to disable.
# SNAP_SAVE_MESSAGES=true

# Optional: show the live "typing…" indicator to the other person while the bot
# types (more human). Default true. Set false to hide it.
# SNAP_SHOW_TYPING=true

# Optional: the Python bridge auto-launches the Node browser runner in the same
# window (default true). Set false to run the runner yourself in a 2nd terminal.
# SNAP_SPAWN_NODE=true

# Optional: base typing delay floor in ms (typing time scales with message length)
# SNAP_TYPING_DELAY_MS=1200
